package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// system/libvintf 的 generated_sources 依赖这个 xsd_config。
// 原定义在 system/apex/apexd/Android.bp，但 apexd 服务在精简
// manifest 下被整体删除；这里只恢复 XSD 生成器，不恢复 apexd。
xsd_config {
    name: "apex-info-list-tinyxml",
    srcs: ["ApexInfoList.xsd"],
    package_name: "com.android.apex",
    api_dir: "apex-info-list-api",
    gen_writer: true,
    tinyxml: true,
    root_elements: ["apex-info-list"],
}
