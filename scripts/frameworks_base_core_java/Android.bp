filegroup {
    name: "IKeyAttestationApplicationIdProvider.aidl",
    srcs: ["android/security/keymaster/IKeyAttestationApplicationIdProvider.aidl"],
}

// Minimal frameworks/base/core/java AIDL interfaces needed by keystore2's
// Rust crate. The stripped manifest does not sync frameworks/base, so these
// modules are injected here together with the AIDL files.
aidl_interface {
    name: "android.os.permissions_aidl",
    unstable: true,
    local_include_dir: ".",
    srcs: [
        "android/os/IPermissionController.aidl",
    ],
    backend: {
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "com.android.virt",
            ],
        },
    },
}

aidl_interface {
    name: "android.security.rkp_aidl",
    unstable: true,
    srcs: [
        "android/security/rkp/*.aidl",
    ],
    backend: {
        rust: {
            enabled: true,
        },
    },
}

// system/vold 的 libvold_binder 通过 whole_static_libs 依赖
// libincremental_aidl-cpp；该模块原定义在 frameworks/base/core/java/Android.bp。
// 精简 manifest 没有同步 frameworks/base，这里补最小 AIDL 模块。
filegroup {
    name: "incremental_aidl",
    srcs: [
        "android/os/incremental/IIncrementalServiceConnector.aidl",
        "android/os/incremental/IncrementalFileSystemControlParcel.aidl",
    ],
}

cc_defaults {
    name: "incremental_default",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wextra-semi",
        "-Werror",
        "-Wzero-as-null-pointer-constant",
        "-DANDROID_BASE_UNIQUE_FD_DISABLE_IMPLICIT_CONVERSION",
    ],
    shared_libs: [
        "libbinder",
        "libutils",
    ],
    aidl: {
        include_dirs: [
            "frameworks/native/aidl/binder",
        ],
        export_aidl_headers: true,
    },
}

cc_library {
    name: "libincremental_aidl-cpp",
    srcs: [
        ":incremental_aidl",
    ],
    defaults: ["incremental_default"],
}

// system/logging/logd 的 liblogd 通过 aidl.libs 依赖
// ILogcatManagerService_aidl；该模块原定义在 frameworks/base/core/java/Android.bp。
aidl_library {
    name: "ILogcatManagerService_aidl",
    srcs: ["android/os/logcat/ILogcatManagerService.aidl"],
}
